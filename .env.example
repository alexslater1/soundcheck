# Soundcheck environment — copy to .env (gitignored) and fill in.
# `make api`, `make worker`, `make up` and the lab read this file. Never commit .env.

# ── Process ────────────────────────────────────────────────────────────────
# Comma-separated roles this process runs: api, scheduler, worker. Locally one process may run all.
SOUNDCHECK_ROLES=api,scheduler,worker

# ── Database (compose service `db`, PostgreSQL 17 + PostGIS) ───────────────
DB_URL=jdbc:postgresql://localhost:5432/soundcheck
DB_USER=soundcheck
DB_PASSWORD=soundcheck

# ── Object storage and queue (LocalStack locally; blank endpoint on AWS) ───
# S3_ENDPOINT blank → real AWS; set → LocalStack with path-style access.
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=soundcheck-media
SQS_QUEUE_URL=http://localhost:4566/000000000000/soundcheck-transcode
AWS_REGION=eu-west-2
# LocalStack accepts any credentials and the API defaults to `test`/`test`, so leave these unset: the
# Makefile exports .env to every recipe, and env-var credentials would override your AWS CLI profile in
# the `make aws-*` targets. On AWS the task role provides credentials.
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# ── Public URLs ────────────────────────────────────────────────────────────
# Where clients reach the edge (Caddy locally, CloudFront on AWS). Media URLs are built from this.
PUBLIC_BASE_URL=http://localhost:8088

# ── Auth ─────────────────────────────────────────────────────────────
# ES256 private key for signing access tokens. Provide ONE of the two; `make keys` writes .secrets/jwt-es256.pem.
# The path is relative to backend/, where `make api` runs (a wrong path silently falls back to an ephemeral key).
JWT_PRIVATE_KEY_PEM=
JWT_PRIVATE_KEY_PATH=../.secrets/jwt-es256.pem

# ── External APIs ────────────────────────────────────────────────────
TICKETMASTER_API_KEY=
LASTFM_API_KEY=
# setlist.fm (free, instant: https://www.setlist.fm/settings/api): the "was it this gig?" lookup when adding a past gig.
SETLISTFM_API_KEY=
# Optional; also set INGESTION_SKIDDLE_ENABLED=true when a key arrives.
SKIDDLE_API_KEY=
INGESTION_SKIDDLE_ENABLED=false
# MusicBrainz needs no key but requires a descriptive User-Agent with a contact address.
MUSICBRAINZ_USER_AGENT="Soundcheck/0.1 (you@example.com)"
# fixtures → JSON under INGESTION_FIXTURES_DIR (offline, CI; the committed set is synthetic); live → real APIs.
INGESTION_MODE=fixtures
# Relative to backend/. Set to ../fixtures/recorded to replay a real recording made by `make record-fixtures`.
INGESTION_FIXTURES_DIR=../fixtures
# Live mode: how many days ahead to fetch, the API-call budget per run, and how many artists to enrich per run
# (MusicBrainz allows 1 request/s, so 300 artists is about five minutes).
INGESTION_HORIZON_DAYS=90
INGESTION_CALL_BUDGET=1500
INGESTION_ENRICH_MAX=300

# ── Admin bootstrap ──────────────────────────────────────────────────
SOUNDCHECK_ADMIN_EMAIL=admin@soundcheck.local
# At least 10 characters; generate one with `openssl rand -base64 18`.
SOUNDCHECK_ADMIN_PASSWORD=change-me-please

# ── Observability ───────────────────────────────────────────────
# OTLP endpoint of grafana/otel-lgtm locally; Grafana Cloud or ADOT on AWS.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── App (Expo) ─────────────────────────────────────────────────────────────
# Base URL the app uses for every request, including media. Android dev builds use `adb reverse tcp:8088 tcp:8088`.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8088
