{
  "name": "soundcheck-app",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "^14.0.4",
    "@hookform/resolvers": "^4.0.0",
    "@tanstack/react-query": "^5.66.0",
    "expo": "~52.0.32",
    "expo-build-properties": "~0.13.2",
    "expo-constants": "~17.0.5",
    "expo-dev-client": "~5.0.12",
    "expo-font": "~13.0.3",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.17",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.54.2",
    "react-native": "0.76.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "^0.19.13",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@testing-library/react-native": "^13.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.18",
    "eslint": "^9.20.1",
    "eslint-config-expo": "^8.0.1",
    "eslint-config-prettier": "^10.0.1",
    "jest": "^29.7.0",
    "jest-expo": "^52.0.3",
    "orval": "^7.5.0",
    "prettier": "^3.5.0",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.7.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "export": "expo export -p web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "openapi": "orval"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/dist/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@tanstack/.*)"
    ]
  }
}
