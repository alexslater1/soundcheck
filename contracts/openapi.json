{
  "components" : {
    "schemas" : {
      "AuthResponse" : {
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresIn" : {
            "format" : "int64",
            "type" : "integer"
          },
          "refreshToken" : {
            "type" : [ "string", "null" ]
          },
          "user" : {
            "$ref" : "#/components/schemas/UserSummary"
          }
        },
        "required" : [ "accessToken", "expiresIn", "user" ],
        "type" : "object"
      },
      "CityResponse" : {
        "properties" : {
          "id" : {
            "format" : "int32",
            "type" : "integer"
          },
          "lat" : {
            "format" : "double",
            "type" : "number"
          },
          "lng" : {
            "format" : "double",
            "type" : "number"
          },
          "name" : {
            "type" : "string"
          },
          "population" : {
            "format" : "int32",
            "type" : [ "integer", "null" ]
          },
          "region" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "id", "lat", "lng", "name" ],
        "type" : "object"
      },
      "GenreResponse" : {
        "properties" : {
          "id" : {
            "format" : "int32",
            "type" : "integer"
          },
          "name" : {
            "type" : "string"
          },
          "parentId" : {
            "format" : "int32",
            "type" : [ "integer", "null" ]
          },
          "slug" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "name", "slug" ],
        "type" : "object"
      },
      "HealthResponse" : {
        "properties" : {
          "status" : {
            "type" : "string"
          },
          "time" : {
            "format" : "date-time",
            "type" : "string"
          },
          "version" : {
            "type" : "string"
          }
        },
        "required" : [ "status", "time", "version" ],
        "type" : "object"
      },
      "LoginRequest" : {
        "properties" : {
          "email" : {
            "format" : "email",
            "minLength" : 1,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 128,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "email", "password" ],
        "type" : "object"
      },
      "RefreshRequest" : {
        "properties" : {
          "refreshToken" : {
            "type" : [ "string", "null" ]
          }
        },
        "type" : "object"
      },
      "RegisterRequest" : {
        "properties" : {
          "displayName" : {
            "maxLength" : 50,
            "minLength" : 1,
            "type" : "string"
          },
          "email" : {
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0,
            "type" : "string"
          },
          "handle" : {
            "maxLength" : 30,
            "minLength" : 3,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 128,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "displayName", "email", "handle", "password" ],
        "type" : "object"
      },
      "UserSummary" : {
        "properties" : {
          "avatarUrl" : {
            "type" : [ "string", "null" ]
          },
          "displayName" : {
            "type" : "string"
          },
          "handle" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "displayName", "handle", "id" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "Gig discovery and concert clips.",
    "title" : "Soundcheck API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/auth/login" : {
      "post" : {
        "operationId" : "login",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-Client",
          "required" : false,
          "schema" : {
            "default" : "web",
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "User-Agent",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Sign in",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "soundcheck_rt",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "X-Client",
          "required" : false,
          "schema" : {
            "default" : "web",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        },
        "summary" : "Revoke the session's refresh-token family",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/refresh" : {
      "post" : {
        "operationId" : "refresh",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "soundcheck_rt",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "X-Client",
          "required" : false,
          "schema" : {
            "default" : "web",
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "X-Requested-With",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "User-Agent",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Rotate the refresh token and get a new access token",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/register" : {
      "post" : {
        "operationId" : "register",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-Client",
          "required" : false,
          "schema" : {
            "default" : "web",
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "User-Agent",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Create an account and start a session",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/cities" : {
      "get" : {
        "operationId" : "searchCities",
        "parameters" : [ {
          "in" : "query",
          "name" : "q",
          "required" : false,
          "schema" : {
            "maxLength" : 60,
            "minLength" : 0,
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/CityResponse"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "UK city autocomplete (max 10, most populous first)",
        "tags" : [ "reference" ]
      }
    },
    "/api/v1/genres" : {
      "get" : {
        "operationId" : "listGenres",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/GenreResponse"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Canonical genre list",
        "tags" : [ "reference" ]
      }
    },
    "/api/v1/health" : {
      "get" : {
        "description" : "Returns UP when the API process is serving.",
        "operationId" : "health",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "API health",
        "tags" : [ "health" ]
      }
    }
  },
  "tags" : [ {
    "description" : "Register, login, refresh, logout",
    "name" : "auth"
  }, {
    "description" : "Genres and cities",
    "name" : "reference"
  }, {
    "description" : "Service health",
    "name" : "health"
  } ]
}
