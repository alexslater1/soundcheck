{
  "components" : {
    "schemas" : {
      "AuthResponse" : {
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresIn" : {
            "format" : "int64",
            "type" : "integer"
          },
          "refreshToken" : {
            "type" : [ "string", "null" ]
          },
          "user" : {
            "$ref" : "#/components/schemas/UserSummary"
          }
        },
        "required" : [ "accessToken", "expiresIn", "user" ],
        "type" : "object"
      },
      "CityResponse" : {
        "properties" : {
          "id" : {
            "format" : "int32",
            "type" : "integer"
          },
          "lat" : {
            "format" : "double",
            "type" : "number"
          },
          "lng" : {
            "format" : "double",
            "type" : "number"
          },
          "name" : {
            "type" : "string"
          },
          "population" : {
            "format" : "int32",
            "type" : [ "integer", "null" ]
          },
          "region" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "id", "lat", "lng", "name" ],
        "type" : "object"
      },
      "Counts" : {
        "properties" : {
          "followers" : {
            "format" : "int64",
            "type" : "integer"
          },
          "following" : {
            "format" : "int64",
            "type" : "integer"
          },
          "posts" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "followers", "following", "posts" ],
        "type" : "object"
      },
      "DeleteMeRequest" : {
        "properties" : {
          "password" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "password" ],
        "type" : "object"
      },
      "GenreChoice" : {
        "properties" : {
          "genreId" : {
            "format" : "int32",
            "type" : "integer"
          },
          "weight" : {
            "format" : "float",
            "maximum" : 1.0,
            "minimum" : 0.0,
            "type" : "number"
          }
        },
        "required" : [ "genreId", "weight" ],
        "type" : "object"
      },
      "GenreResponse" : {
        "properties" : {
          "id" : {
            "format" : "int32",
            "type" : "integer"
          },
          "name" : {
            "type" : "string"
          },
          "parentId" : {
            "format" : "int32",
            "type" : [ "integer", "null" ]
          },
          "slug" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "name", "slug" ],
        "type" : "object"
      },
      "GenreWeight" : {
        "properties" : {
          "genreId" : {
            "format" : "int32",
            "type" : "integer"
          },
          "weight" : {
            "format" : "float",
            "type" : "number"
          }
        },
        "required" : [ "genreId", "weight" ],
        "type" : "object"
      },
      "GenresRequest" : {
        "properties" : {
          "genres" : {
            "items" : {
              "$ref" : "#/components/schemas/GenreChoice"
            },
            "maxItems" : 8,
            "minItems" : 0,
            "type" : "array"
          }
        },
        "required" : [ "genres" ],
        "type" : "object"
      },
      "HealthResponse" : {
        "properties" : {
          "status" : {
            "type" : "string"
          },
          "time" : {
            "format" : "date-time",
            "type" : "string"
          },
          "version" : {
            "type" : "string"
          }
        },
        "required" : [ "status", "time", "version" ],
        "type" : "object"
      },
      "HomeCity" : {
        "properties" : {
          "id" : {
            "format" : "int32",
            "type" : "integer"
          },
          "lat" : {
            "format" : "double",
            "type" : "number"
          },
          "lng" : {
            "format" : "double",
            "type" : "number"
          },
          "name" : {
            "type" : "string"
          },
          "region" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "id", "lat", "lng", "name" ],
        "type" : "object"
      },
      "LoginRequest" : {
        "properties" : {
          "email" : {
            "format" : "email",
            "minLength" : 1,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 128,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "email", "password" ],
        "type" : "object"
      },
      "MeResponse" : {
        "properties" : {
          "avatarUrl" : {
            "type" : [ "string", "null" ]
          },
          "bio" : {
            "type" : [ "string", "null" ]
          },
          "counts" : {
            "$ref" : "#/components/schemas/Counts"
          },
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "genres" : {
            "items" : {
              "$ref" : "#/components/schemas/GenreWeight"
            },
            "type" : "array"
          },
          "handle" : {
            "type" : "string"
          },
          "homeCity" : {
            "$ref" : "#/components/schemas/HomeCity",
            "type" : "null"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "onboarded" : {
            "type" : "boolean"
          },
          "role" : {
            "type" : "string"
          }
        },
        "required" : [ "counts", "displayName", "email", "genres", "handle", "id", "onboarded", "role" ],
        "type" : "object"
      },
      "ProfileResponse" : {
        "properties" : {
          "avatarUrl" : {
            "type" : [ "string", "null" ]
          },
          "bio" : {
            "type" : [ "string", "null" ]
          },
          "counts" : {
            "$ref" : "#/components/schemas/Counts"
          },
          "displayName" : {
            "type" : "string"
          },
          "handle" : {
            "type" : "string"
          },
          "homeCityName" : {
            "type" : [ "string", "null" ]
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "counts", "displayName", "handle", "id" ],
        "type" : "object"
      },
      "RefreshRequest" : {
        "properties" : {
          "refreshToken" : {
            "type" : [ "string", "null" ]
          }
        },
        "type" : "object"
      },
      "RegisterRequest" : {
        "properties" : {
          "displayName" : {
            "maxLength" : 50,
            "minLength" : 1,
            "type" : "string"
          },
          "email" : {
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0,
            "type" : "string"
          },
          "handle" : {
            "maxLength" : 30,
            "minLength" : 3,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 128,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "displayName", "email", "handle", "password" ],
        "type" : "object"
      },
      "UpdateMeRequest" : {
        "properties" : {
          "bio" : {
            "maxLength" : 300,
            "minLength" : 0,
            "type" : [ "string", "null" ]
          },
          "displayName" : {
            "maxLength" : 50,
            "minLength" : 1,
            "type" : [ "string", "null" ]
          },
          "handle" : {
            "maxLength" : 30,
            "minLength" : 3,
            "type" : [ "string", "null" ]
          },
          "homeCityId" : {
            "format" : "int32",
            "type" : [ "integer", "null" ]
          }
        },
        "type" : "object"
      },
      "UserSummary" : {
        "properties" : {
          "avatarUrl" : {
            "type" : [ "string", "null" ]
          },
          "displayName" : {
            "type" : "string"
          },
          "handle" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "displayName", "handle", "id" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "Gig discovery and concert clips.",
    "title" : "Soundcheck API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/auth/login" : {
      "post" : {
        "operationId" : "login",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-Client",
          "required" : false,
          "schema" : {
            "default" : "web",
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "User-Agent",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Sign in",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "soundcheck_rt",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "X-Client",
          "required" : false,
          "schema" : {
            "default" : "web",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        },
        "summary" : "Revoke the session's refresh-token family",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/refresh" : {
      "post" : {
        "operationId" : "refresh",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "soundcheck_rt",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "X-Client",
          "required" : false,
          "schema" : {
            "default" : "web",
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "X-Requested-With",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "User-Agent",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Rotate the refresh token and get a new access token",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/register" : {
      "post" : {
        "operationId" : "register",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-Client",
          "required" : false,
          "schema" : {
            "default" : "web",
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "User-Agent",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Create an account and start a session",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/cities" : {
      "get" : {
        "operationId" : "searchCities",
        "parameters" : [ {
          "in" : "query",
          "name" : "q",
          "required" : false,
          "schema" : {
            "maxLength" : 60,
            "minLength" : 0,
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/CityResponse"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "UK city autocomplete (max 10, most populous first)",
        "tags" : [ "reference" ]
      }
    },
    "/api/v1/genres" : {
      "get" : {
        "operationId" : "listGenres",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/GenreResponse"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Canonical genre list",
        "tags" : [ "reference" ]
      }
    },
    "/api/v1/health" : {
      "get" : {
        "description" : "Returns UP when the API process is serving.",
        "operationId" : "health",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "API health",
        "tags" : [ "health" ]
      }
    },
    "/api/v1/me" : {
      "delete" : {
        "operationId" : "deleteMe",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/DeleteMeRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        },
        "summary" : "Delete the account (password confirm); purge after 7 days",
        "tags" : [ "me" ]
      },
      "get" : {
        "operationId" : "getMe",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The signed-in user's account",
        "tags" : [ "me" ]
      },
      "patch" : {
        "operationId" : "updateMe",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateMeRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Edit profile fields (only the ones sent)",
        "tags" : [ "me" ]
      }
    },
    "/api/v1/me/genres" : {
      "put" : {
        "operationId" : "setMyGenres",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/GenresRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Replace the explicit genre preferences (1–8)",
        "tags" : [ "me" ]
      }
    },
    "/api/v1/me/onboarding/complete" : {
      "post" : {
        "operationId" : "completeOnboarding",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Mark onboarding as done",
        "tags" : [ "me" ]
      }
    },
    "/api/v1/users/{handle}" : {
      "get" : {
        "operationId" : "getUserByHandle",
        "parameters" : [ {
          "in" : "path",
          "name" : "handle",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProfileResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Public profile",
        "tags" : [ "me" ]
      }
    }
  },
  "tags" : [ {
    "description" : "Register, login, refresh, logout",
    "name" : "auth"
  }, {
    "description" : "Genres and cities",
    "name" : "reference"
  }, {
    "description" : "Own account, onboarding, profiles",
    "name" : "me"
  }, {
    "description" : "Service health",
    "name" : "health"
  } ]
}
