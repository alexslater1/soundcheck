{
  "components" : {
    "schemas" : {
      "CityResponse" : {
        "properties" : {
          "id" : {
            "format" : "int32",
            "type" : "integer"
          },
          "lat" : {
            "format" : "double",
            "type" : "number"
          },
          "lng" : {
            "format" : "double",
            "type" : "number"
          },
          "name" : {
            "type" : "string"
          },
          "population" : {
            "format" : "int32",
            "type" : [ "integer", "null" ]
          },
          "region" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "id", "lat", "lng", "name" ],
        "type" : "object"
      },
      "GenreResponse" : {
        "properties" : {
          "id" : {
            "format" : "int32",
            "type" : "integer"
          },
          "name" : {
            "type" : "string"
          },
          "parentId" : {
            "format" : "int32",
            "type" : [ "integer", "null" ]
          },
          "slug" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "name", "slug" ],
        "type" : "object"
      },
      "HealthResponse" : {
        "properties" : {
          "status" : {
            "type" : "string"
          },
          "time" : {
            "format" : "date-time",
            "type" : "string"
          },
          "version" : {
            "type" : "string"
          }
        },
        "required" : [ "status", "time", "version" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "Gig discovery and concert clips.",
    "title" : "Soundcheck API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/cities" : {
      "get" : {
        "operationId" : "searchCities",
        "parameters" : [ {
          "in" : "query",
          "name" : "q",
          "required" : false,
          "schema" : {
            "maxLength" : 60,
            "minLength" : 0,
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/CityResponse"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "UK city autocomplete (max 10, most populous first)",
        "tags" : [ "reference" ]
      }
    },
    "/api/v1/genres" : {
      "get" : {
        "operationId" : "listGenres",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/GenreResponse"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Canonical genre list",
        "tags" : [ "reference" ]
      }
    },
    "/api/v1/health" : {
      "get" : {
        "description" : "Returns UP when the API process is serving.",
        "operationId" : "health",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "API health",
        "tags" : [ "health" ]
      }
    }
  },
  "tags" : [ {
    "description" : "Genres and cities",
    "name" : "reference"
  }, {
    "description" : "Service health",
    "name" : "health"
  } ]
}
