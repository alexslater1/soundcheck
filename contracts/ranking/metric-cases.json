{
  "version": 1,
  "description": "Hand-computed cases for the ranking metrics. Java (RankingMetrics, asserted by RankingMetricsTest) and the Python lab's evaluate must give these answers within the tolerance. expected null means the metric is undefined for that input. Each case's 'why' is the hand computation.",
  "tolerance": 1e-9,
  "overlapAt": [
    { "name": "identical lists", "k": 3, "a": ["p1", "p2", "p3"], "b": ["p1", "p2", "p3"], "expected": 1.0,
      "why": "3 of 3 in common" },
    { "name": "half the top four shared, in another order", "k": 4, "a": ["p1", "p2", "p3", "p4"], "b": ["p4", "p3", "p5", "p6"], "expected": 0.5,
      "why": "p3 and p4 in common: 2 / 4" },
    { "name": "only the first k count", "k": 2, "a": ["p1", "p2", "p3"], "b": ["p3", "p1", "p2"], "expected": 0.5,
      "why": "tops {p1,p2} and {p3,p1}: 1 / 2" },
    { "name": "a shorter list cannot score 1", "k": 4, "a": ["p1", "p2"], "b": ["p1", "p2", "p3", "p4"], "expected": 0.5,
      "why": "2 in common / the longer cut list (4)" },
    { "name": "both empty", "k": 10, "a": [], "b": [], "expected": null, "why": "undefined" }
  ],
  "kendallTauB": [
    { "name": "identical", "x": [1, 2, 3, 4, 5], "y": [1, 2, 3, 4, 5], "expected": 1.0,
      "why": "10 concordant pairs, no ties: 10 / sqrt(10 * 10)" },
    { "name": "reversed", "x": [1, 2, 3, 4, 5], "y": [5, 4, 3, 2, 1], "expected": -1.0,
      "why": "10 discordant pairs: -10 / 10" },
    { "name": "five items, one swap and one tie", "x": [1, 2, 3, 4, 5], "y": [1, 3, 2, 4, 4], "expected": 0.7378647873726218,
      "why": "pairs (1,2) discordant, (3,4) tied in y, the other 8 concordant: (8 - 1) / sqrt((10 - 0) * (10 - 1)) = 7 / sqrt(90)" },
    { "name": "two ties, no disagreement", "x": [1, 2, 3, 4, 5], "y": [1, 1, 2, 2, 3], "expected": 0.8944271909999159,
      "why": "2 pairs tied in y, 8 concordant: 8 / sqrt(10 * 8)" },
    { "name": "one item", "x": [1], "y": [1], "expected": null, "why": "no pairs" },
    { "name": "all tied on one side", "x": [1, 2, 3], "y": [7, 7, 7], "expected": null, "why": "denominator sqrt(3 * 0) = 0" }
  ],
  "auc": [
    { "name": "perfect", "scores": [0.9, 0.8, 0.3, 0.1], "positive": [true, true, false, false], "expected": 1.0,
      "why": "every positive above every negative: 4 / 4" },
    { "name": "the textbook case", "scores": [0.1, 0.4, 0.35, 0.8], "positive": [false, false, true, true], "expected": 0.75,
      "why": "0.35 beats 0.1, loses to 0.4; 0.8 beats both: 3 / 4" },
    { "name": "ties count half", "scores": [0.5, 0.5, 0.5, 0.2], "positive": [true, false, false, true], "expected": 0.25,
      "why": "0.5 vs 0.5 twice: 0.5 + 0.5; 0.2 loses twice: 1 / 4" },
    { "name": "no negatives", "scores": [0.3, 0.6], "positive": [true, true], "expected": null, "why": "no pairs" }
  ],
  "logLoss": [
    { "name": "two confident right answers", "probabilities": [0.9, 0.2], "positive": [true, false], "expected": 0.164252033486018,
      "why": "-(ln 0.9 + ln 0.8) / 2 = (0.1053605 + 0.2231436) / 2" },
    { "name": "a certain miss is clipped", "probabilities": [0.0], "positive": [true], "expected": 34.538776394910684,
      "why": "p clipped to 1e-15: -ln 1e-15 = 15 ln 10" },
    { "name": "no items", "probabilities": [], "positive": [], "expected": null, "why": "undefined" }
  ],
  "ndcgAt": [
    { "name": "the positive second", "k": 10, "scores": [0.9, 0.5, 0.1], "positive": [false, true, false], "expected": 0.6309297535714575,
      "why": "gain at rank 1 = 1 / log2(3); ideal 1" },
    { "name": "perfect after re-ranking", "k": 10, "scores": [0.2, 0.9], "positive": [false, true], "expected": 1.0,
      "why": "the positive moves to rank 0" },
    { "name": "ties keep the order shown", "k": 10, "scores": [0.5, 0.5], "positive": [false, true], "expected": 0.6309297535714575,
      "why": "equal scores: shown order, the positive stays at rank 1" },
    { "name": "below the cut", "k": 10, "scores": [0.9, 0.8, 0.7, 0.6, 0.5, 0.4, 0.3, 0.2, 0.1, 0.05, 0.04, 0.01], "positive": [false, false, false, false, false, false, false, false, false, false, false, true], "expected": 0.0,
      "why": "the only positive ranks 11th, outside the top 10" },
    { "name": "three positives, k = 3", "k": 3, "scores": [0.9, 0.8, 0.7, 0.6], "positive": [true, false, true, true], "expected": 0.7039180890341347,
      "why": "DCG = 1 + 1 / log2(4) = 1.5; ideal = 1 + 1 / log2(3) + 1 / log2(4) = 2.1309298" },
    { "name": "no positive", "k": 10, "scores": [0.4, 0.3], "positive": [false, false], "expected": null, "why": "sessions without a positive are left out" }
  ]
}
