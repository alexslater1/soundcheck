{
  "app": "npx ts-node --prefer-ts-exts bin/soundcheck.ts",
  "watch": {
    "include": ["**"],
    "exclude": ["README.md", "cdk*.json", "**/*.d.ts", "**/*.js", "tsconfig.json", "package*.json", "node_modules", "test"]
  },
  "context": {
    "@aws-cdk/core:newStyleStackSynthesis": true,
    "@aws-cdk/core:defaultCrossStackReferences": "strong",
    "env": "demo",
    "cloudFrontPrefixListId": "pl-fab65393",
    "apiCpu": 512,
    "apiMemoryMiB": 1024,
    "apiMinTasks": 1,
    "apiMaxTasks": 2,
    "workerCpu": 4096,
    "workerMemoryMiB": 8192,
    "workerMinTasks": 0,
    "workerMaxTasks": 2,
    "pushEnabled": false,
    "otlpEnabled": false,
    "ingestionMode": "live",
    "setlistBackfill": true
  }
}
